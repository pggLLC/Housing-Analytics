{
  "schema": "vacancy-tax/1",
  "meta": {
    "title": "Colorado vacancy taxes: who can levy one, who has tried, and what it could raise",
    "as_of": "2026-11-16",
    "last_verified": "2026-11-16",
    "review_by": "2027-02-16",
    "method": "Curated, not a feed. Each authority and measure record was read from its own source on the check date, and its quote is copied from that source. verification.level \"primary\" means the statute, bill, constitution, ballot language or government release; \"reported\" means a named news or tally page. The revenue estimates are not a source record: they are computed by scripts/policy/vacancy-tax.mjs from ACS 2020-2024 5-year table B25004 (data/hna/vacancy-status.json) and B25001 (data/hna/housing-units-b25001.json), using the cases below, which are COHO assumptions.",
    "renter_owner": "A vacancy tax is paid by the OWNER of a home that is not lived in. Renters pay nothing directly; a home with a long-term tenant counts as occupied.",
    "estimate": {
      "rate_usd": 4000,
      "rate_note": "Boulder 2J rate (2026), used for every place so places compare on one rate.",
      "base": "ACS vacant homes held for seasonal, recreational or occasional use (B25004_006) plus other vacant (B25004_008). Homes for rent, for sale, rented or sold and not yet occupied, and migrant-worker housing are left out as normal turnover.",
      "formula": "revenue = (seasonal x seasonal_share + other_vacant x other_share) x collected x rate",
      "cases": {
        "low": {
          "seasonal_share": 0.4,
          "other_share": 0.2,
          "collected": 0.6
        },
        "middle": {
          "seasonal_share": 0.6,
          "other_share": 0.35,
          "collected": 0.75
        },
        "high": {
          "seasonal_share": 0.8,
          "other_share": 0.5,
          "collected": 0.9
        }
      },
      "assumptions_are": "COHO assumptions, not published research: some seasonal homes are lived in more than half the year, rented long-term part of the year or used as short-term rentals; much of other vacant (repairs, estates, owners in care) is what hardship exemptions cover; owners respond by renting, selling or proving occupancy.",
      "table_floor_usd": 1000000,
      "share_floor": 0.25,
      "min_base": 100
    },
    "known_gaps": [
      "ACS counts a home as vacant on the day it was surveyed. A home lived in four months a year can be counted as occupied, so ACS is a cautious base for a 183-day test.",
      "Small-town seasonal counts carry wide margins of error; treat their dollars as an order of magnitude.",
      "Short-term rentals are counted as taxable. A town that exempts them, as HB26-1036 would have, has a smaller base; official license counts are on record here only for a few towns.",
      "Municipal types (home rule or statutory) are from the Wikipedia list of Colorado municipalities, which cites DOLA; DOLA's own list could not be opened from COHO's tools. Check a town's charter before relying on its status.",
      "Central City (home rule) has no ACS vacancy record in COHO's data and is not estimated.",
      "No Colorado court has ruled on whether a vacancy excise tax is a non-uniform property tax.",
      "Boulder's exemptions, proof of occupancy and enforcement are not set until a 2027 ordinance."
    ]
  },
  "authority": [
    {
      "id": "hb26-1036",
      "title": "HB26-1036, local taxes on vacant residential property",
      "status": "failed",
      "decided": "2026-02-09",
      "summary": "Would have let counties and municipalities, with voter approval, levy an excise tax or a vacant-property tax class on vacant homes, short-term rentals excluded, money for affordable, attainable or workforce housing only. Postponed indefinitely in the House Finance Committee.",
      "source": {
        "url": "https://leg.colorado.gov/bill_files/116817/download",
        "title": "HB26-1036 final fiscal note",
        "publisher": "Colorado Legislative Council Staff",
        "quote": "This bill was postponed indefinitely by the House Finance Committee on February 9, 2026; therefore, the impacts identified in this analysis do not take effect.",
        "date": "2026-06-01"
      },
      "more_sources": [
        {
          "url": "https://s3.us-west-2.amazonaws.com/beta.leg.colorado.gov/fa2b6aeab13c2dd99430e23de5314648",
          "title": "HB26-1036 introduced text",
          "publisher": "Colorado General Assembly",
          "quote": "MAY USE THE REVENUES COLLECTED FROM AN EXCISE TAX IMPOSED PURSUANT TO THIS SECTION ONLY FOR AFFORDABLE, ATTAINABLE, OR WORKFORCE HOUSING, AS DEFINED BY THE COUNTY OR MUNICIPALITY.",
          "date": "2026-01-14"
        },
        {
          "url": "https://coloradosun.com/2026/02/11/vacancy-tax-legislation-fails/",
          "title": "Legislature rejects attempt to let Colorado communities increase taxes on often-vacant homes",
          "publisher": "The Colorado Sun",
          "quote": "the 11-member House Finance Committee voted 7-4 against the measure",
          "date": "2026-02-11"
        }
      ],
      "verification": {
        "checked": "2026-11-16",
        "level": "primary"
      },
      "review_by": "2027-01-20"
    },
    {
      "id": "home-rule",
      "title": "Home-rule cities and towns (Colo. Const. art. XX, sec. 6)",
      "status": "in_force",
      "summary": "Home-rule municipalities hold the power to levy and collect taxes for municipal purposes. With voter approval they can levy a vacancy excise tax without a state law; Boulder did in 2026. Untested in court.",
      "source": {
        "url": "https://olls.info/crs/crs2024-title-00.htm",
        "title": "Colorado Constitution, Article XX, Section 6 (C.R.S. 2024, constitution volume)",
        "publisher": "Colorado Office of Legislative Legal Services",
        "quote": "the levy and collection of taxes thereon for municipal purposes"
      },
      "more_sources": [
        {
          "url": "https://crestedbuttenews.com/2026/03/cb-town-council-open-to-exploring-a-new-tax-on-vacant-homes/",
          "title": "CB town council open to exploring a new tax on vacant homes",
          "publisher": "Crested Butte News",
          "quote": "Because Crested Butte is a home rule municipality, it already has the authority to take such a measure to its voters.",
          "date": "2026-03-18"
        }
      ],
      "verification": {
        "checked": "2026-11-16",
        "level": "primary"
      },
      "review_by": "2027-02-16"
    },
    {
      "id": "statutory-and-counties",
      "title": "Statutory towns, statutory cities and counties",
      "status": "no_authority",
      "summary": "They hold only the powers a statute grants. No statute grants a vacancy tax; HB26-1036 would have. A statutory town can adopt a home-rule charter first.",
      "source": {
        "url": "https://crestedbuttenews.com/2026/03/cb-town-council-open-to-exploring-a-new-tax-on-vacant-homes/",
        "title": "CB town council open to exploring a new tax on vacant homes",
        "publisher": "Crested Butte News",
        "quote": "State lawmakers earlier this year rejected a bill to allow statutory municipalities and counties to tax vacant residential properties with voter approval.",
        "date": "2026-03-18"
      },
      "verification": {
        "checked": "2026-11-16",
        "level": "reported"
      },
      "review_by": "2027-01-20"
    },
    {
      "id": "tabor",
      "title": "TABOR (Colo. Const. art. X, sec. 20)",
      "status": "in_force",
      "summary": "Any new tax needs voter approval in advance, decided at a state general election, a biennial local district election, or on the first Tuesday in November of an odd-numbered year; the ballot title must open \"SHALL (DISTRICT) TAXES BE INCREASED\"; keeping money above the revenue limit needs a voter-approved revenue change; debt needs its own approval; new real estate transfer taxes are banned.",
      "source": {
        "url": "https://olls.info/crs/crs2024-title-00.htm",
        "title": "Colorado Constitution, Article X, Section 20 (C.R.S. 2024, constitution volume)",
        "publisher": "Colorado Office of Legislative Legal Services",
        "quote": "New or increased transfer tax rates on real property are prohibited."
      },
      "verification": {
        "checked": "2026-11-16",
        "level": "primary"
      },
      "review_by": "2027-02-16",
      "more_sources": [
        {
          "url": "https://olls.info/crs/crs2024-title-00.htm",
          "title": "Colorado Constitution, Article X, Section 20 (C.R.S. 2024, constitution volume)",
          "publisher": "Colorado Office of Legislative Legal Services",
          "quote": "Ballot issues shall be decided in a state general election, biennial local district election, or on the first Tuesday in November of odd-numbered years."
        }
      ]
    },
    {
      "id": "uniformity",
      "title": "Property tax uniformity (Colo. Const. art. X, sec. 3)",
      "status": "in_force",
      "summary": "Property taxes must be uniform within a class. A vacancy tax built as a property tax would need a new class from the state; a local tax is built as an excise, and could be challenged as a property tax in disguise.",
      "source": {
        "url": "https://olls.info/crs/crs2024-title-00.htm",
        "title": "Colorado Constitution, Article X, Section 3 (C.R.S. 2024, constitution volume)",
        "publisher": "Colorado Office of Legislative Legal Services",
        "quote": "Each property tax levy shall be uniform upon all real and personal property not exempt from taxation under this article"
      },
      "verification": {
        "checked": "2026-11-16",
        "level": "primary"
      },
      "review_by": "2027-02-16"
    }
  ],
