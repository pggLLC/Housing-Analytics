{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy-watch/v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "policy-watch/v1"
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "as_of": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "title",
        "as_of",
        "method",
        "known_gaps"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "section": {
            "enum": [
              "qap",
              "ballot",
              "people"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "detail": {
            "type": "string"
          },
          "programs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "source": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https:\\/\\/[^/\\s?#]+(?:/[^\\s]*)?$"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          },
          "verification": {
            "type": "object",
            "properties": {
              "level": {
                "enum": [
                  "primary",
                  "reported"
                ]
              },
              "against": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "checked": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "by": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "level",
              "against",
              "checked"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "level": {
                      "const": "reported"
                    }
                  }
                },
                "then": {
                  "required": [
                    "by"
                  ]
                }
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "redline": {
                  "type": "object",
                  "properties": {
                    "struck": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "inserted": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "struck",
                    "inserted"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "section",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "not_in_source": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "derived": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "figure": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sum_of": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "figure",
                "sum_of"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "agency": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "appointing_authority": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "predecessor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "person": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          },
          "action": {
            "enum": [
              "appointed",
              "nominated",
              "confirmed",
              "resigned",
              "replaced",
              "interim"
            ]
          },
          "dates": {
            "type": "object",
            "properties": {
              "nominated": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "confirmed": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effective": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "term_end": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "nominated",
              "confirmed",
              "effective",
              "term_end"
            ],
            "additionalProperties": false
          },
          "relevance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "section",
          "status",
          "date",
          "title",
          "detail",
          "programs",
          "source",
          "verification",
          "evidence"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "section": {
                  "not": {
                    "const": "people"
                  }
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "role"
                    ]
                  },
                  {
                    "required": [
                      "agency"
                    ]
                  },
                  {
                    "required": [
                      "appointing_authority"
                    ]
                  },
                  {
                    "required": [
                      "predecessor"
                    ]
                  },
                  {
                    "required": [
                      "person"
                    ]
                  },
                  {
                    "required": [
                      "action"
                    ]
                  },
                  {
                    "required": [
                      "dates"
                    ]
                  },
                  {
                    "required": [
                      "relevance"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "meta",
    "entries"
  ],
  "additionalProperties": false
}
