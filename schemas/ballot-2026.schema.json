{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ballot/v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ballot/v1"
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "geoid": {
            "type": "string",
            "pattern": "^08(?:\\d{3}|\\d{5})?$"
          },
          "level": {
            "enum": [
              "state",
              "county",
              "municipal"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "coverage_state": {
            "enum": [
              "verified_measure_found",
              "official_ballot_reviewed_none_found",
              "not_researched",
              "official_notice_unavailable",
              "source_unreadable",
              "not_applicable"
            ]
          },
          "reviewed_source": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https:\\/\\/[^/\\s?#]+(?:/[^\\s]*)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "checked": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "entry_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "reviewed_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https:\\/\\/[^/\\s?#]+(?:/[^\\s]*)?$"
                },
                "retrieved": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "url",
                "retrieved"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "geoid",
          "level",
          "name",
          "coverage_state",
          "reviewed_source",
          "checked",
          "entry_ids",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "election": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "type": {
                "enum": [
                  "general",
                  "coordinated",
                  "special"
                ]
              }
            },
            "required": [
              "date",
              "type"
            ],
            "additionalProperties": false
          },
          "jurisdiction": {
            "type": "object",
            "properties": {
              "geoid": {
                "type": "string",
                "pattern": "^08(?:\\d{3}|\\d{5})?$"
              },
              "level": {
                "enum": [
                  "state",
                  "county",
                  "municipal"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "geoid",
              "level",
              "name"
            ],
            "additionalProperties": false
          },
          "measure": {
            "type": "object",
            "properties": {
              "number": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "official_title": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "origin": {
                "enum": [
                  "referred",
                  "initiated"
                ]
              },
              "relevance": {
                "type": "array",
                "items": {
                  "enum": [
                    "housing_finance",
                    "housing_tax",
                    "land_use",
                    "homelessness",
                    "property_tax"
                  ]
                },
                "minItems": 1
              },
              "fiscal": {
                "type": "object",
                "properties": {
                  "mechanism": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "rate": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "amount_cap": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "duration": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sunset": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "mechanism",
                  "rate",
                  "amount_cap",
                  "duration",
                  "sunset"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "number",
              "official_title",
              "origin",
              "relevance",
              "fiscal"
            ],
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "proposed",
              "title_set",
              "petitioning",
              "certified",
              "on_ballot",
              "passed",
              "failed",
              "withdrawn",
              "litigated"
            ]
          },
          "sources": {
            "type": "object",
            "properties": {
              "certification": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https:\\/\\/[^/\\s?#]+(?:/[^\\s]*)?$"
                      },
                      "retrieved": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    },
                    "required": [
                      "url",
                      "retrieved"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "official_text": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https:\\/\\/[^/\\s?#]+(?:/[^\\s]*)?$"
                      },
                      "retrieved": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    },
                    "required": [
                      "url",
                      "retrieved"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ballot_notice": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https:\\/\\/[^/\\s?#]+(?:/[^\\s]*)?$"
                      },
                      "retrieved": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    },
                    "required": [
                      "url",
                      "retrieved"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "blue_book": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https:\\/\\/[^/\\s?#]+(?:/[^\\s]*)?$"
                      },
                      "retrieved": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    },
                    "required": [
                      "url",
                      "retrieved"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resolution": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https:\\/\\/[^/\\s?#]+(?:/[^\\s]*)?$"
                      },
                      "retrieved": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    },
                    "required": [
                      "url",
                      "retrieved"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "certification",
              "official_text",
              "ballot_notice",
              "blue_book",
              "resolution"
            ],
            "additionalProperties": false
          },
          "neutral_title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "detail": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "section",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "verification": {
            "type": "object",
            "properties": {
              "level": {
                "enum": [
                  "primary",
                  "reported"
                ]
              },
              "against": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "checked": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "by": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "level",
              "against",
              "checked"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "level": {
                      "const": "reported"
                    }
                  }
                },
                "then": {
                  "required": [
                    "by"
                  ]
                }
              }
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "result": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "outcome": {
                    "enum": [
                      "passed",
                      "failed"
                    ]
                  },
                  "stage": {
                    "enum": [
                      "unofficial",
                      "certified"
                    ]
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "pattern": "^https:\\/\\/[^/\\s?#]+(?:/[^\\s]*)?$"
                      },
                      "retrieved": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                      }
                    },
                    "required": [
                      "url",
                      "retrieved"
                    ],
                    "additionalProperties": false
                  },
                  "as_of": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "outcome",
                  "stage",
                  "source",
                  "as_of"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "checked": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "source": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https:\\/\\/[^/\\s?#]+(?:/[^\\s]*)?$"
                        },
                        "retrieved": {
                          "type": "string",
                          "format": "date",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        }
                      },
                      "required": [
                        "url",
                        "retrieved"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "checked",
                "note",
                "source"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "election",
          "jurisdiction",
          "measure",
          "status",
          "sources",
          "neutral_title",
          "detail",
          "evidence",
          "verification",
          "limitations",
          "result",
          "history",
          "archived"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "coverage",
    "entries"
  ],
  "additionalProperties": false
}
